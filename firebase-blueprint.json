{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer profile and preferences stored per authenticated user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "fullName": { "type": "string", "description": "Customer full name" },
        "email": { "type": "string", "description": "Customer email" },
        "phone": { "type": "string", "description": "Bangladeshi phone number" },
        "avatarUrl": { "type": "string", "description": "Profile picture URL" },
        "preferredLanguage": { "type": "string", "enum": ["en", "bn"] },
        "notificationsEnabled": { "type": "boolean" },
        "promoNotificationsEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "fullName", "createdAt", "updatedAt"]
    },
    "DeliveryAddress": {
      "title": "DeliveryAddress",
      "description": "Saved Bangladeshi delivery address for a customer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "area": { "type": "string" },
        "fullAddress": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "label", "fullName", "phone", "district", "upazila", "fullAddress", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Synchronized shopping cart line item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productNameBn": { "type": "string" },
        "imageResName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "unitPrice": { "type": "number" },
        "regularPrice": { "type": "number" },
        "selectedSize": { "type": "string" },
        "selectedColor": { "type": "string" },
        "quantity": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "productName", "unitPrice", "quantity", "createdAt", "updatedAt"]
    },
    "WishlistItem": {
      "title": "WishlistItem",
      "description": "Customer saved wishlist item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "productNameBn": { "type": "string" },
        "imageResName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "price": { "type": "number" },
        "regularPrice": { "type": "number" },
        "inStock": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "productName", "price", "createdAt", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app push notification history item for a customer.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "titleBn": { "type": "string" },
        "message": { "type": "string" },
        "messageBn": { "type": "string" },
        "type": { "type": "string", "enum": ["order", "payment", "promo"] },
        "orderId": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category managed by admin.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "iconName": { "type": "string" },
        "displayOrder": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "nameBn", "isActive", "createdAt", "updatedAt"]
    },
    "Product": {
      "title": "Product",
      "description": "E-commerce product listing in Best Shoping BD catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameBn": { "type": "string" },
        "description": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "brand": { "type": "string" },
        "regularPrice": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "integer" },
        "imageResNames": { "type": "array" },
        "imageUrls": { "type": "array" },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "categoryId", "brand", "regularPrice", "discountPrice", "stock", "createdAt", "updatedAt"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Customer rating and review for a product.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "reviewerName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "productId", "reviewerName", "rating", "comment", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order with delivery, payment, and live tracking history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "area": { "type": "string" },
        "fullAddress": { "type": "string" },
        "orderNotes": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "couponCode": { "type": "string" },
        "couponDiscount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "transactionId": { "type": "string" },
        "status": { "type": "string" },
        "estimatedDelivery": { "type": "string" },
        "trackingHistory": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "customerName", "customerPhone", "district", "upazila", "fullAddress", "items", "subtotal", "deliveryCharge", "totalAmount", "paymentMethod", "paymentStatus", "status", "createdAt", "updatedAt"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Payment transaction record linked to an order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderId": { "type": "string" },
        "method": { "type": "string" },
        "amount": { "type": "number" },
        "transactionId": { "type": "string" },
        "status": { "type": "string" },
        "verificationNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "orderId", "method", "amount", "status", "createdAt", "updatedAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon code.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercent": { "type": "integer" },
        "maxDiscountBdt": { "type": "number" },
        "minOrderBdt": { "type": "number" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountPercent", "isActive", "createdAt", "updatedAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store branding, delivery charges, payment configuration, and banners.",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "tagline": { "type": "string" },
        "contactNumber": { "type": "string" },
        "companyAddress": { "type": "string" },
        "dhakaDeliveryCharge": { "type": "number" },
        "outsideDhakaDeliveryCharge": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "bkashMerchantNumber": { "type": "string" },
        "nagadMerchantNumber": { "type": "string" },
        "rocketMerchantNumber": { "type": "string" },
        "upayMerchantNumber": { "type": "string" },
        "enabledPaymentMethods": { "type": "array" },
        "banners": { "type": "array" },
        "facebookUrl": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "promoBannerText": { "type": "string" },
        "promoBannerTextBn": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["appName", "tagline", "contactNumber", "companyAddress", "dhakaDeliveryCharge", "outsideDhakaDeliveryCharge", "updatedAt"]
    },
    "AdminMember": {
      "title": "AdminMember",
      "description": "Authorized admin user record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private customer profile and preferences."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/DeliveryAddress" },
      "description": "Customer delivery addresses."
    },
    "/users/{userId}/cart/{cartItemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "Synchronized cart items."
    },
    "/users/{userId}/wishlist/{productId}": {
      "schema": { "$ref": "#/entities/WishlistItem" },
      "description": "Customer wishlist products."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Customer notification center."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMember" },
      "description": "Admin role membership lookup."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Store product categories."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Store product catalog."
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/ProductReview" },
      "description": "Product customer reviews."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and live tracking timeline."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Payment records and verification statuses."
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Promotional discount coupons."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store settings and promotional banners."
    }
  }
}
